{
	"name": "vmfa-search",
	"version": "0.1.0",
	"description": "Fast, typo-tolerant search for the Media Library, powered by Loupe Search. Add-on for Virtual Media Folders.",
	"author": "Per Soderlind",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"lint:js": "wp-scripts lint-js assets/js",
		"lint:css": "wp-scripts lint-style assets/css",
		"test": "vitest run",
		"test:watch": "vitest",
		"i18n": "npm run i18n:make-pot && npm run i18n:update-po && npm run i18n:make-mo && npm run i18n:make-json && npm run i18n:make-php",
		"i18n:make-pot": "wp i18n make-pot . languages/vmfa-search.pot --exclude=node_modules,vendor,tests --domain=vmfa-search",
		"i18n:update-po": "wp i18n update-po languages/vmfa-search.pot languages/",
		"i18n:make-mo": "wp i18n make-mo languages/",
		"i18n:make-json": "wp i18n make-json languages/ --no-purge --use-map=i18n-map.json",
		"i18n:make-php": "wp i18n make-php languages/"
	},
	"devDependencies": {
		"@testing-library/dom": "^10.4.0",
		"@testing-library/user-event": "^14.6.1",
		"@wordpress/eslint-plugin": "^24.1.0",
		"@wordpress/scripts": "^34.1.0",
		"jsdom": "^28.0.0",
		"vitest": "^4.0.18"
	}
}
